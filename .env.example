# ============================================================
# AI Instagram News Automation — Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# --- Instagram Credentials (username/password, no API needed) ---
INSTAGRAM_USERNAME=your_instagram_username_here
INSTAGRAM_PASSWORD=your_instagram_password_here

# --- Gemini AI API Key (get free at aistudio.google.com) ---
GEMINI_API_KEY=paste_your_gemini_key_here

# --- NewsAPI.org Key (optional, free at newsapi.org) ---
NEWS_API_KEY=paste_your_newsapi_key_here

# --- Schedule (24h format, IST timezone) ---
RESEARCH_HOUR=8
RESEARCH_MINUTE=0
PUBLISH_HOUR=9
PUBLISH_MINUTE=0

# --- Server Config ---
HOST=0.0.0.0
PORT=8000
