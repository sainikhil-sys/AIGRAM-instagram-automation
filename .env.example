# ============================================================
# AI Instagram News Automation — Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# --- Meta Graph API Credentials ---
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- Gemini AI API Key (get free at aistudio.google.com) ---
GEMINI_API_KEY=

# --- NewsAPI.org Key (optional, free at newsapi.org) ---
NEWS_API_KEY=

# --- Database & Cache Connection Strings (Neon & Upstash) ---
DATABASE_URL=
REDIS_URL=

# --- Cloudinary Storage API ---
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Sentry & Metrics ---
SENTRY_DSN=
ENABLE_METRICS=true

# --- Schedule (24h format, IST timezone) ---
RESEARCH_HOUR=8
RESEARCH_MINUTE=0
PUBLISH_HOUR=9
PUBLISH_MINUTE=0

# --- Server Config ---
HOST=0.0.0.0
PORT=8000
